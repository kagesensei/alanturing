[MAIN]
persistent=no
recursive=yes
ignore=.venv,.idea,.git
# Some cryptanalysis modules import a sibling roadmap item's module
# (e.g. brute_force_cracker imports enigma_simulator/enigma.py) via a
# sys.path addition at runtime rather than duplicating that code. This
# mirrors that addition so Pylint can actually resolve the import too,
# instead of the check being suppressed. Assumes pylint is run from the
# repo root, as documented in CLAUDE.md.
init-hook='import sys; sys.path.extend(["cryptanalysis/enigma_simulator", "cryptanalysis/bombe_simulator", "cryptanalysis/frequency_analysis", "persona/alan_turing", "turing_machines/basic_simulator", "turing_machines/arithmetic_turing_machine", "bonus/turing_test_simulator"])'

[MESSAGES CONTROL]
enable=all
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods

[DESIGN]
# NASA Power of 10, rule 4: keep functions to roughly one printed page.
max-statements=60
max-branches=10
max-locals=15
max-args=7
max-positional-arguments=7
max-nested-blocks=4
# LorenzSettings legitimately holds 8 fields (a pattern + start position
# for each of 4 wheel groups) -- it's a plain data holder, not a class
# whose behavior is getting too tangled.
max-attributes=8

[FORMAT]
max-line-length=100

[BASIC]
good-names=i,j,k,x,y,_
