{
  "schema_version": 1,
  "meta": {
    "name": "IPIP-NEO-120 reconstruction shell for the Alan Turing persona",
    "instrument": "International Personality Item Pool NEO (IPIP-NEO-120), item/facet structure per John A. Johnson (2014), 'Measuring thirty facets of the five factor model with a 120-item public-domain inventory', Journal of Research in Personality.",
    "disclaimer": "This is a historical reconstruction exercise, not a claim that Alan Turing took the IPIP-NEO-120 or any personality inventory.",
    "phase": 1,
    "status": "structural shell only -- no items scored in Phase 1",
    "why_no_item_text_yet": "IPIP items are public domain, but this project only records item text once it has been transcribed directly from a verified IPIP source and cross-checked, rather than reproduced from unverified memory -- to avoid introducing transcription errors into what is meant to be an evidence-grounded dataset. Phase 2 will populate item_text alongside verified sourcing, and will only set proposed_response/evidence_type/confidence/source_ids/rationale away from their UNKNOWN defaults where the evidence genuinely supports it -- not for all 120 items simply because the questionnaire contains 120 items.",
    "total_items": 120
  },
